      },
      "terms": [
        {
          "en": "programming / coding",
          "target": "Programmieren",
          "use": "de",
          "notes": "Standard.",
          "anchor": "term-programming-coding"
        },
        {
          "en": "streak",
          "target": "Streak",
          "use": "en",
          "notes": "Loanword; Duolingo's own German app uses \"Streak\" verbatim, and German learning platforms follow suit.",
          "anchor": "term-streak"
        },
        {
          "en": "tech / tech industry",
          "target": "Tech-Branche",
          "use": "de",
          "notes": "Hybrid (English \"Tech\" + German \"Branche\"), established in German tech media.",
          "anchor": "term-tech-tech-industry"
        },
        {
          "en": "developer",
          "target": "Entwickler(in)",
          "use": "de",
          "notes": "Standard German equivalent.",
          "anchor": "term-developer"
        },
        {
          "en": "pitfall",
          "target": "Falle",
          "use": "de",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-pitfall"
