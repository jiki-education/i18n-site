      },
      "terms": [
        {
          "en": "character",
          "target": "caráter (pl. carateres)",
          "use": "pt-pt",
          "notes": "Post-1990 spelling: European Portuguese silences the `c`, giving \"carateres\" (Brazilian keeps it: \"caractere/caracteres\").",
          "anchor": "term-character"
        },
        {
          "en": "float / decimal",
          "target": "número de vírgula flutuante",
          "use": "pt-pt",
          "notes": "European Portuguese says \"vírgula flutuante\" (decimal comma); Brazilian says \"ponto flutuante\" (decimal point). Use \"decimal\" alone when the floating-point nature does not matter.",
          "anchor": "term-float-decimal"
        }
      ]
    },
