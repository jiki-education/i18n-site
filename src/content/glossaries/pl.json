          "target": "narzędzie / narzędzia",
          "use": "pl",
          "notes": "\"Tooling\" as an abstract collective renders descriptively (e.g. _ekosystem narzędzi_) rather than as one fixed word.",
          "anchor": "term-tool-tooling"
        },
        {
          "en": "module",
          "target": "moduł",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-module"
        },
        {
          "en": "algorithm",
          "target": "algorytm",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-algorithm"
        },
        {
          "en": "edge case",
          "target": "przypadek brzegowy",
          "use": "pl",
          "anchor": "term-edge-case"
        },
        {
          "en": "backwards compatibility",
          "target": "kompatybilność wsteczna",
          "use": "pl",
          "anchor": "term-backwards-compatibility"
        },
        {
          "en": "component",
          "target": "komponent",
