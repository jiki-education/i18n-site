#!/usr/bin/env node
//
// build-subtitles — generate the sample clip's caption tracks, one per language.
//
// Usage:
//   ./bin/build-subtitles
//
// Writes: public/media/subtitles/<lang>.vtt  (28 languages plus English)
//
// These are fixtures, not content. The video-player page exists so people can
// review Video.js's own UI strings in their language, and the captions menu is
// part of that UI: you cannot judge a menu with one item in it. So every page
// offers two tracks, English and its own language, and each track just says what
// it is on repeat. A reviewer opens the menu, picks one, and can tell at a glance
// which track is playing without having to follow a script.
//
// The text is deliberately trivial for a second reason: it is unreviewed. These
// lines have not been through a translation pass and are not glossary-governed,
// the same footing as the `comingSoon` strings in src/lib/languages.ts. A reviewer
// spotting one that reads badly is a fine outcome, not a bug.
//
// Committed output, so a normal `pnpm build` never runs this. Re-run it after
// changing the strings or the sample clip.

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const OUT_DIR = path.join(ROOT, "public", "media", "subtitles");

/** Length of public/media/sample.mp4, in seconds. */
const CLIP_SECONDS = 20;
/** Cue length. Short enough that scrubbing anywhere lands mid-cue. */
const CUE_SECONDS = 4;

/**
 * "These are <language> subtitles", in each language. Unreviewed: see above.
 * Keys match src/lib/languages.ts, plus `en` for the English track every page
 * carries alongside its own.
 */
const LINES = {
  en: "These are English subtitles",
  ar: "هذه هي الترجمة العربية",
  bn: "এগুলো বাংলা সাবটাইটেল",
  ca: "Aquests són els subtítols en català",
  de: "Das sind deutsche Untertitel",
  el: "Αυτοί είναι ελληνικοί υπότιτλοι",
  "es-419": "Estos son los subtítulos en español",
  "es-ES": "Estos son los subtítulos en español",
  fa: "اینها زیرنویس فارسی هستند",
  fr: "Voici les sous-titres en français",
  hi: "ये हिन्दी उपशीर्षक हैं",
  hu: "Ezek magyar feliratok",
  id: "Ini adalah subtitle bahasa Indonesia",
  it: "Questi sono i sottotitoli in italiano",
  ja: "これは日本語の字幕です",
  ko: "한국어 자막입니다",
  nl: "Dit zijn Nederlandse ondertitels",
  pl: "To są polskie napisy",
  "pt-BR": "Estas são as legendas em português",
  "pt-pt": "Estas são as legendas em português",
  ru: "Это русские субтитры",
  sr: "Ово су српски титлови",
  sw: "Hizi ni manukuu ya Kiswahili",
  tr: "Bunlar Türkçe altyazılardır",
  uk: "Це українські субтитри",
  ur: "یہ اردو سب ٹائٹلز ہیں",
  vi: "Đây là phụ đề tiếng Việt",
  "zh-CN": "这是中文字幕",
  "zh-TW": "這是中文字幕"
};

function timestamp(seconds) {
  const whole = Math.floor(seconds);
  const mm = String(Math.floor(whole / 60)).padStart(2, "0");
  const ss = String(whole % 60).padStart(2, "0");
  const ms = String(Math.round((seconds - whole) * 1000)).padStart(3, "0");
  return `00:${mm}:${ss}.${ms}`;
}

function vtt(lang, line) {
  const cues = [];
  let index = 0;
  for (let start = 0; start < CLIP_SECONDS; start += CUE_SECONDS) {
    const end = Math.min(start + CUE_SECONDS, CLIP_SECONDS);
    index += 1;
    cues.push(`${index}\n${timestamp(start)} --> ${timestamp(end)}\n${line}`);
  }

  return [
    "WEBVTT",
    "",
    "NOTE",
    `Fixture captions for the review site's sample clip (${lang}). Not Jiki lesson`,
    "content, and not through a translation pass. They exist so the captions menu",
    "has something to choose between, because that menu is part of what is being",
    "reviewed. Generated by bin/build-subtitles.",
    "",
    ...cues.flatMap((cue) => [cue, ""])
  ].join("\n");
}

fs.rmSync(OUT_DIR, { recursive: true, force: true });
fs.mkdirSync(OUT_DIR, { recursive: true });

for (const [lang, line] of Object.entries(LINES)) {
  fs.writeFileSync(path.join(OUT_DIR, `${lang}.vtt`), vtt(lang, line));
}

console.log(`Wrote ${Object.keys(LINES).length} caption tracks to ${path.relative(ROOT, OUT_DIR)}`);
