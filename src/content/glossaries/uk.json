    {
      "title": "Values & data types",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "value",
          "target": "значення",
          "use": "uk",
          "notes": "Ordinary word.",
          "anchor": "term-value"
        },
        {
          "en": "number",
          "target": "число",
          "use": "uk",
          "notes": "Ordinary word.",
          "anchor": "term-number"
        },
        {
          "en": "character",
          "target": "символ",
          "use": "uk",
          "notes": "Correction from an earlier community proposal (\"знак\"); _символ_ is the term used throughout php.org.ua's string-function docs.",
          "anchor": "term-character"
        },
        {
          "en": "integer",
          "target": "ціле число",
          "use": "uk",
          "anchor": "term-integer"
        },
        {
          "en": "true / false",
          "target": "правда / неправда",
          "use": "uk",
          "notes": "_Істина/хиба_ (a more formal-logic register) is an accepted alternative; do not mix both in one document. Not capitalised in prose.",
          "anchor": "term-true-false"
        },
        {
          "en": "float / decimal",
          "target": "число з плаваючою комою / десяткове число",
          "use": "uk",
          "notes": "Use the first form when the floating-point nature matters, the second for the simpler beginner sense.",
          "anchor": "term-float-decimal"
        },
        {
          "en": "array / list",
          "target": "масив",
          "use": "uk",
          "notes": "Exercise prose sometimes says \"list\" informally for the same concept; render both with _масив_, do not introduce a second word.",
          "anchor": "term-array-list"
        },
        {
          "en": "dictionary",
          "target": "словник",
          "use": "uk",
          "anchor": "term-dictionary"
        },
        {
          "en": "element",
          "target": "елемент",
          "use": "uk",
          "notes": "Array element = _елемент масиву_.",
          "anchor": "term-element"
        },
        {
          "en": "index",
          "target": "індекс",
          "use": "uk",
          "notes": "Direct cognate; no clarification parens needed.",
          "anchor": "term-index"
        },
        {
          "en": "key-value pair",
          "target": "пара ключ-значення",
          "use": "uk",
          "notes": "The key itself is _ключ_ (ordinary word once introduced).",
          "anchor": "term-key-value-pair"
        },
        {
          "en": "template literal",
          "target": "шаблонний рядок",
          "use": "uk",
          "anchor": "term-template-literal"
        }
      ]
