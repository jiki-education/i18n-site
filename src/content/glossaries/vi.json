          "anchor": "term-break"
        },
        {
          "en": "increment",
          "target": "tăng",
          "use": "vi",
          "notes": "\"Tăng giá trị của biến đếm.\"",
          "anchor": "term-increment"
        },
        {
          "en": "modulo / remainder operator",
          "target": "phép chia lấy dư",
          "use": "vi",
          "notes": "The `%` operator.",
          "anchor": "term-modulo-remainder-operator"
        },
        {
          "en": "concatenation / to concatenate",
          "target": "nối chuỗi",
          "use": "vi",
          "anchor": "term-concatenation-to-concatenate"
        },
        {
          "en": "state / stateful",
          "target": "trạng thái",
          "use": "vi",
          "notes": "**Flagged for native-speaker review**: React/JS-facing Vietnamese prose often keeps English \"state\" instead; we standardise on the native term since Jiki teaches the general concept, not a specific framework.",
          "anchor": "term-state-stateful"
        },
        {
          "en": "scope",
          "target": "scope",
          "use": "en",
          "notes": "Where the source `<define>`s it, gloss as \"phạm vi (biến)\". Matches the Hungarian/Japanese pattern of keeping this specific term English; Vietnamese developer prose commonly keeps \"scope\" too, especially in fixed compounds (block scope, function scope).",
          "anchor": "term-scope"
        },
        {
          "en": "class",
          "target": "lớp",
          "use": "vi",
          "anchor": "term-class"
        },
        {
          "en": "method",
          "target": "phương thức",
          "use": "vi",
          "anchor": "term-method"
        },
        {
          "en": "property",
          "target": "thuộc tính",
          "use": "vi",
          "anchor": "term-property"
        },
        {
          "en": "object",
          "target": "đối tượng",
          "use": "vi",
          "anchor": "term-object"
        }
      ]
    },
