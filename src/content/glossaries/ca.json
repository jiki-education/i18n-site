          "notes": "Confirmed by textbook chapter usage (\"Condicionals encadenats\").",
          "anchor": "term-if-statement"
        },
        {
          "en": "condition",
          "target": "condició",
          "use": "ca",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-condition"
        },
        {
          "en": "comparison",
          "target": "comparació",
          "use": "ca",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-comparison"
        },
        {
          "en": "expression",
          "target": "expressió",
          "use": "ca",
          "notes": "Transparent cognate.",
          "anchor": "term-expression"
        },
        {
          "en": "operator",
          "target": "operador",
          "use": "ca",
          "notes": "Transparent cognate.",
          "anchor": "term-operator"
