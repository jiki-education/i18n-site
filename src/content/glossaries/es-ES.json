        "notes": 3
      },
      "terms": [
        {
          "en": "statement (executable)",
          "target": "instrucción",
          "use": "es-ES",
          "notes": "The imperative sense: a line of code that does something and gets executed. Deliberately distinct from _operador_.",
          "anchor": "term-statement"
        },
        {
          "en": "statement (logical claim)",
          "target": "afirmación",
          "use": "es-ES",
          "notes": "The proposition sense: a claim that is true or false; also a test assertion. Pick by meaning, not by the English word. _Enunciado_ is an accepted alternative in a more formal-logic register.",
          "anchor": "term-statement-2"
        },
        {
          "en": "return value",
          "target": "valor devuelto",
          "use": "es-ES",
          "notes": "Noun form; _valor de retorno_ is an accepted alternative. Distinct from the verb \"to return\".",
          "anchor": "term-return-value"
        }
      ]
    },
