---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ReviewCountBadge from "../components/ReviewCountBadge.astro";
import StageBadge from "../components/StageBadge.astro";
import { languageMeta } from "../lib/languages";
import { languageReviewTargets } from "../lib/review-targets";

const glossaries = await getCollection("glossaries");
const translations = await getCollection("translations");

const languages = glossaries
  .map((glossary) => {
    const lang = glossary.data.lang;
    const items = translations.filter((t) => t.data.lang === lang);
    return {
      lang,
      meta: languageMeta(lang),
      stage: glossary.data.stage,
      termCount: glossary.data.term_count ?? 0,
      reviewTargets: languageReviewTargets(lang, glossary.data, items)
    };
  })
  .sort((a, b) => a.meta.name.localeCompare(b.meta.name));

const QUICK_LINKS = [
  {
    label: "Kickoff live stream",
    detail: "Friday 1pm UTC, YouTube",
    href: "https://youtube.com/live/UAxC5J4H2n0"
  },
  {
    label: "Discord",
    detail: "The #translation channel, where we work",
    href: "https://discord.gg/JFty3vbqRZ"
  },
  {
    label: "The forum",
    detail: "Where decisions get recorded",
    href: "https://forum.jiki.io/c/i18n/67"
  },
  {
    label: "All languages",
    detail: "Every language we're translating into",
    href: "/languages"
  },
  {
    label: "The blog post",
    detail: "The full story of the Translatathon",
    href: "https://jiki.io/blog/translatathon"
  }
];
---

<Layout title="Jiki Translations" description="The Big Jiki & Exercism Translatathon: read the translations as they land, check the agreed glossaries, and tell us what sounds wrong.">
  <PageHeader title="The Big Jiki & Exercism Translatathon" subtitle="Translating both platforms into as many languages as we can, over the weekend of July 31st - August 2nd." crumbs={[{ label: "Home" }]} image="/images/translatathon.webp">
    <div slot="meta" class="mt-5 flex flex-wrap gap-3">
      <a href="https://discord.gg/JFty3vbqRZ" class="rounded-lg bg-white px-4 py-2.5 text-[15px] font-semibold text-purple-800 transition hover:bg-purple-100"> Join us on Discord </a>
      <a href="https://forum.jiki.io/c/i18n/67" class="rounded-lg border border-purple-400 px-4 py-2.5 text-[15px] font-semibold text-white transition hover:bg-purple-800"> Discuss on the Forum </a>
    </div>
  </PageHeader>

  <div class="lg-container grid gap-10 py-10 lg:grid-cols-[1fr_350px] lg:gap-[7%]">
    <article class="min-w-0">
      {/* Sits outside .textual-content so the prose rules don't restyle it. This
          is the one block on the page that has to survive being skimmed. */}
      <div class="mb-9 rounded-2xl border-2 border-purple-200 bg-purple-50 p-6">
        <h2 class="text-[13px] font-bold tracking-[0.08em] text-purple-700 uppercase">TL;DR</h2>
        <ol class="mt-4 space-y-3 text-[16px] leading-relaxed text-gray-800">
          <li class="flex gap-3">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-purple-600 text-[13px] font-bold text-white">1</span>
            <span>Choose your language from the list on the right of this page.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-purple-600 text-[13px] font-bold text-white">2</span>
            <span>Click through its content pages: the glossary, the video player, the exercises and the concepts.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-purple-600 text-[13px] font-bold text-white">3</span>
            <span>For each one, <strong>post on the forum</strong>, either telling us it's good or telling us what needs to change.</span>
          </li>
        </ol>
        <p class="mt-4 border-t border-purple-200 pt-4 text-[16px] leading-relaxed text-gray-800">
          You can pin your language and mark things as reviewed, but those are just for you. <strong>I only see what you post on the forum.</strong> Thanks for helping!
        </p>
      </div>

      <div class="textual-content">
        <h2>What is this?</h2>

        <p>
          Most people in the world don't speak English, but most coding resources are only in English. So we're translating the whole of Jiki: the UI, the videos, the exercises, even the <strong>error messages</strong> you get from the programming language itself. And it's not just Jiki. Exercism is being translated too, using the same process and the same glossaries.
        </p>

        <p>Nothing here is final. That's the point. If it reads like a robot wrote it, we want to know before it ships.</p>

        <h2>How does it work?</h2>

        <p>We're using LLMs to do the initial translating. However, if you just ask an LLM to translate, it's not great. But with good guidance and a good glossary, it gets much better fast. So the plan is for us to translate using the LLM and then get your feedback, refine, and continue to loop.</p>

        <p>Each language goes through three stages:</p>

        <ol>
          <li>
            <strong>Setup:</strong> We provide a glossary and a sample article. Tell us if the tone is right, if the choice of words is sensible, etc. At this point, the focus is on <strong>guiding the LLM to do a better job of translating</strong>. Once we've got your sign off we move onto stage two.
          </li>
          <li>
            <strong>Refinement:</strong> We'll give you lots of different articles for you to check - continue the work you did in (1) spotting <strong>weird words or phrasing</strong> and improving things. Once you're getting to the stage that you're finding not much wrong, we'll move you onto stage 3.
          </li>
          <li>
            <strong>Review:</strong> We bulk-translate lots of the website and you start focussing on getting each actual piece of content right. At this stage we're focussing much more on the actual final versions of the copy.
          </li>
        </ol>

        <h2>What do I do?</h2>

        <p>In general, your job is to read something in your language and tell us when it sounds weird. If you can tell us why it's weird, that's great, but even if it just sounds off, that's useful information. Some coding experience helps with the technical terms, but it isn't required.</p>

        <p>There are three places to know about:</p>

        <ol>
          <li><a href="https://discord.gg/JFty3vbqRZ">Discord</a> - where you can have live discussion.</li>
          <li><a href="https://forum.jiki.io/c/i18n/67">Our forum</a> - where formal comments occur that we base updates off.</li>
          <li>Here - where lots of content lives.</li>
        </ol>

        <p>
          Start by watching the <a href="https://youtube.com/live/UAxC5J4H2n0">Getting Started livestream</a>, then say hello on the forum and on Discord in the relevant sections.
        </p>

        <p>To get started find your language from the list on the right-hand side and follow the instructions on that page.</p>

        <h3>What if my language isn't listed yet?</h3>

        <p>
          Post on <a href="https://forum.jiki.io/t/request-a-new-language-for-translation/714">this thread in the forum</a> and we'll bootstrap it: a forum section for your language and a starting glossary to discuss. And if you know other native speakers who'd help out, get them to post too. The more people working on a language, the better it'll be.
        </p>
      </div>
    </article>

    <aside class="min-w-0 space-y-6">
      <section id="pinned-section" class="hidden rounded-2xl border border-gray-200 bg-white p-5">
        <h2 id="pinned-heading" class="text-[13px] font-bold tracking-[0.08em] text-gray-500 uppercase">Your languages</h2>
        <ul id="pinned-languages" class="mt-3 divide-y divide-gray-100"></ul>
      </section>

      <section class="rounded-2xl border border-gray-200 bg-white p-5">
        <h2 class="text-[13px] font-bold tracking-[0.08em] text-gray-500 uppercase">Quick links</h2>
        <ul class="mt-3 space-y-1">
          {
            QUICK_LINKS.map((link) => (
              <li>
                <a href={link.href} class="-mx-2 block rounded-lg px-2 py-2 transition hover:bg-purple-50">
                  <span class="block text-[15px] font-semibold text-blue-600">{link.label}</span>
                  <span class="block text-[13px] text-gray-500">{link.detail}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="rounded-2xl border border-gray-200 bg-white p-5">
        <h2 class="text-[13px] font-bold tracking-[0.08em] text-gray-500 uppercase">
          All languages <span class="text-gray-400">({languages.length})</span>
        </h2>
        <ul id="all-languages" class="mt-3 divide-y divide-gray-100">
          {
            languages.map(({ lang, meta, stage, termCount, reviewTargets }) => (
              <li data-lang={lang}>
                <a href={`/${lang}`} class="-mx-2 flex items-center gap-3 rounded-lg px-2 py-2 transition hover:bg-purple-50">
                  <span class="min-w-0 flex-1">
                    <span class="flex items-center gap-2">
                      <span class="truncate text-[15px] font-semibold text-blue-600">{meta.name}</span>
                      <StageBadge stage={stage} class="shrink-0" />
                    </span>
                    <span class="block text-[12px] text-gray-500">
                      <span lang={lang} dir={meta.dir}>
                        {meta.nativeName}
                      </span>{" "}
                      &middot; {termCount} terms
                    </span>
                  </span>
                  <ReviewCountBadge targets={reviewTargets} class="shrink-0 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <script>
        import { PINNED_STORAGE_KEY } from "../lib/pinned";
        import { readReviewed, applyReviewCount } from "../lib/review-counts";

        let pinned: string[] = [];
        try {
          const raw = localStorage.getItem(PINNED_STORAGE_KEY);
          const parsed = raw ? JSON.parse(raw) : [];
          pinned = Array.isArray(parsed) ? parsed : [];
        } catch {
          pinned = [];
        }

        const section = document.getElementById("pinned-section");
        const pinnedList = document.getElementById("pinned-languages");
        const allList = document.getElementById("all-languages");

        if (section && pinnedList && allList && pinned.length > 0) {
          const reviewed = readReviewed();
          // The pinned block is a copy: pinned languages stay in the full list
          // below too, in their normal alphabetical place. Walk the list in order
          // so the pinned block reads alphabetically as well.
          for (const li of Array.from(allList.querySelectorAll<HTMLElement>("li[data-lang]"))) {
            if (!pinned.includes(li.dataset.lang ?? "")) continue;
            const clone = li.cloneNode(true) as HTMLElement;
            const badge = clone.querySelector<HTMLElement>(".review-count-badge");
            if (badge) applyReviewCount(badge, reviewed);
            pinnedList.appendChild(clone);
          }
          const count = pinnedList.children.length;
          if (count > 0) {
            const heading = document.getElementById("pinned-heading");
            if (heading) heading.textContent = count === 1 ? "Your language" : "Your languages";
            section.classList.remove("hidden");
          }
        }
      </script>
    </aside>
  </div>
</Layout>
