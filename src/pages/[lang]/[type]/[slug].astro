---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ReviewToggle from "../../../components/ReviewToggle.astro";
import { alignBlocks, renderBlock, splitBlocks } from "../../../lib/markdown";
import { contentTypeLabel, contentTypeSingular, forumCategoryUrl, languageMeta } from "../../../lib/languages";
import { reviewItemId } from "../../../lib/reviewed";

export const getStaticPaths = (async () => {
  const translations = await getCollection("translations");
  const english = await getCollection("english");

  return translations
    .filter((t) => t.data.status === "published")
    .map((translation) => {
      const source = english.find((e) => e.data.type === translation.data.type && e.data.slug === translation.data.slug);
      return {
        params: { lang: translation.data.lang, type: translation.data.type, slug: translation.data.slug },
        props: { translation, source }
      };
    });
}) satisfies GetStaticPaths;

const { translation, source } = Astro.props;
const { lang, type, slug, title, en_md5, content_version, forum_topic_id } = translation.data;
const meta = languageMeta(lang);

/** The English source moved on after this was translated. */
const stale = Boolean(source && en_md5 && source.data.en_md5 !== en_md5);

const targetBody = translation.body ?? "";
const englishBody = source?.body ?? "";

const aligned = englishBody ? alignBlocks(englishBody, targetBody) : null;
const targetOnly = splitBlocks(targetBody).map(renderBlock);

const forumUrl = forum_topic_id ? `https://forum.jiki.io/t/${forum_topic_id}` : forumCategoryUrl(lang);
---

<Layout title={title ?? slug} description={`${contentTypeLabel(type)}: ${slug}, translated into ${meta.name}. Read it against the English and tell us what sounds wrong.`}>
  <PageHeader title={title ?? slug} titleLang={lang} titleDir={meta.dir} subtitle={`This is a draft translation of the "${source?.data.title ?? slug}" ${contentTypeSingular(type)}.`} crumbs={[{ label: "Languages", href: "/" }, { label: meta.name, href: `/${lang}` }, { label: contentTypeLabel(type) }]} />

  <div class="lg-container py-8">
    {
      (stale || aligned?.mismatch) && (
        <div class="mb-6 space-y-3">
          {stale && (
            <p class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-3.5 text-[14px] text-amber-900">
              <strong>The English has changed since this was translated.</strong> The two columns below are still worth reading against each other, but expect some drift. A fresh translation is queued.
            </p>
          )}
          {aligned?.mismatch && (
            <p class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-3.5 text-[14px] text-amber-900">
              <strong>The two versions don't have the same number of paragraphs.</strong> Translations are meant to keep the structure of the original, so this is itself a bug worth reporting. Rows below may not line up.
            </p>
          )}
        </div>
      )
    }

    <div class="mb-5 max-w-2xl rounded-2xl border border-gray-200 bg-gray-50 p-6">
      <h2 class="text-[19px] font-bold text-gray-900">Review this {contentTypeSingular(type)}</h2>
      <p class="mt-2 text-[15px] text-gray-600">
        You're reading in {meta.name}. Tell us anything that sounds off, however small. If it's a <strong class="font-semibold text-gray-800">single word</strong>, correct it in <a href={`/${lang}/glossary`} class="font-semibold text-blue-600 hover:text-blue-700">the glossary</a> and it gets fixed everywhere at once. If it's <strong class="font-semibold text-gray-800">phrasing</strong>, tell us on <a href={forumUrl} class="font-semibold text-blue-600 hover:text-blue-700">the forum</a>. If you can't explain why, that's ok - tell us anyway!
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a href={forumUrl} class="inline-block rounded-lg bg-purple-600 px-5 py-2.5 text-[15px] font-semibold text-white transition hover:bg-purple-700"> Discuss on the Forum </a>
        <ReviewToggle itemId={reviewItemId(lang, type, slug)} version={content_version ?? en_md5 ?? "unknown"} />
      </div>
    </div>

    {
      aligned && (
        <div>
          <div class="sticky top-[57px] z-10 hidden gap-8 border-b border-gray-200 bg-white/95 py-2.5 backdrop-blur lg:grid lg:grid-cols-2">
            <span class="text-[12px] font-bold tracking-[0.08em] text-gray-400 uppercase">English</span>
            <span class="text-[12px] font-bold tracking-[0.08em] text-gray-400 uppercase">{meta.name}</span>
          </div>

          <div class="divide-y divide-gray-100">
            <div class="grid gap-4 py-5 lg:grid-cols-2 lg:gap-8">
              <h2 class="text-[24px] leading-[1.25] font-bold text-gray-500">{source?.data.title ?? slug}</h2>
              <h2 class="text-[24px] leading-[1.25] font-bold text-gray-900" lang={lang} dir={meta.dir}>
                {title ?? slug}
              </h2>
            </div>
            {aligned.rows.map((row) => (
              <div class="grid gap-4 py-5 lg:grid-cols-2 lg:gap-8">
                <div class="textual-content text-[17px] text-gray-500">{row.english ? <Fragment set:html={row.english} /> : <p class="text-[13px] italic">Nothing in the English here.</p>}</div>
                <div class="textual-content text-[18px]" lang={lang} dir={meta.dir}>
                  {row.target ? <Fragment set:html={row.target} /> : <p class="text-[13px] text-amber-700 italic">Missing from the translation.</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      !aligned && (
        <div class="textual-content md-container !px-0 text-[18px]" lang={lang} dir={meta.dir}>
          <h2 class="mb-5 text-[28px] leading-[1.25] font-bold text-gray-900">{title ?? slug}</h2>
          {targetOnly.map((html) => (
            <Fragment set:html={html} />
          ))}
        </div>
      )
    }
  </div>
</Layout>
