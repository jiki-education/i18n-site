        {
          "en": "NOT operator / logical negation",
          "target": "negació lògica",
          "use": "ca",
          "notes": "Transparent phrase.",
          "anchor": "term-not-operator-logical-negation"
        },
        {
          "en": "statement (executable)",
          "target": "sentència",
          "use": "ca",
          "notes": "The imperative sense: a line of code that does something and gets executed.",
          "anchor": "term-statement"
        },
        {
          "en": "statement (logical claim)",
          "target": "afirmació",
          "use": "ca",
          "notes": "The proposition sense: a claim that is true or false. Keep distinct from _sentència_ above; pick by meaning, not by the English word.",
          "anchor": "term-statement-2"
        },
        {
          "en": "function",
          "target": "funció",
          "use": "ca",
          "notes": "Transparent cognate. The *keyword* `function` in code stays English; the concept in prose is _funció_.",
          "anchor": "term-function"
        },
        {
          "en": "to call (a function)",
          "target": "cridar",
          "use": "ca",
          "notes": "_cridar la funció_. Medium confidence, standard verb by analogy with other Romance-language CS usage.",
          "anchor": "term-to-call"
        },
        {
          "en": "to define (a function)",
          "target": "definir",
          "use": "ca",
          "notes": "Transparent cognate.",
          "anchor": "term-to-define"
        },
        {
          "en": "parameter",
          "target": "paràmetre",
          "use": "ca",
          "notes": "Transparent cognate; the declaration-site name.",
          "anchor": "term-parameter"
        },
        {
          "en": "argument",
          "target": "argument",
          "use": "ca",
          "notes": "Transparent cognate; the call-site value.",
          "anchor": "term-argument"
        },
        {
          "en": "input (to a function)",
          "target": "entrada",
          "use": "ca",
          "anchor": "term-input"
        },
        {
          "en": "output",
          "target": "sortida",
          "use": "ca",
          "anchor": "term-output"
        },
        {
          "en": "to return (a value)",
          "target": "retornar",
          "use": "ca",
          "notes": "\"La funció retorna un valor.\"",
          "anchor": "term-to-return"
        },
        {
          "en": "return value",
          "target": "valor de retorn",
          "use": "ca",
          "anchor": "term-return-value"
        },
        {
          "en": "pure function",
          "target": "funció pura",
          "use": "ca",
          "notes": "Transparent phrase.",
          "anchor": "term-pure-function"
        }
      ]
