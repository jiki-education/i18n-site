          "anchor": "term-loop"
        },
        {
          "en": "for loop",
          "target": "ciclo for",
          "use": "it",
          "notes": "Keep `for` as the real keyword + _ciclo_.",
          "anchor": "term-for-loop"
        },
        {
          "en": "while loop",
          "target": "ciclo while",
          "use": "it",
          "notes": "As above, with `while`.",
          "anchor": "term-while-loop"
        },
        {
          "en": "for-of loop",
          "target": "ciclo for...of",
          "use": "it",
          "notes": "As above, with `for...of`.",
          "anchor": "term-for-of-loop"
        },
        {
          "en": "loop body",
          "target": "corpo del ciclo",
          "use": "it",
          "anchor": "term-loop-body"
        },
        {
          "en": "break (loop control)",
          "target": "istruzione break",
          "use": "it",
          "notes": "The keyword `break` in code stays English; this is the prose concept of breaking out of a loop.",
          "anchor": "term-break"
        },
        {
          "en": "increment",
          "target": "incremento",
          "use": "it",
          "notes": "Verb: _incrementare_.",
          "anchor": "term-increment"
        },
        {
          "en": "modulo / remainder operator",
          "target": "operatore modulo (operator) / resto (value)",
          "use": "it",
          "notes": "Use _operatore modulo_ for the `%` operator; _resto_ for the resulting value.",
          "anchor": "term-modulo-remainder-operator"
        },
        {
          "en": "concatenation / to concatenate",
          "target": "concatenazione / concatenare",
          "use": "it",
          "anchor": "term-concatenation-to-concatenate"
        },
        {
          "en": "toggle",
          "target": "alternare",
          "use": "it",
          "notes": "Verb; a plain, natural Italian word, no need to borrow \"toggle\".",
          "anchor": "term-toggle"
        },
        {
          "en": "state / stateful",
          "target": "stato",
          "use": "it",
          "notes": "\"con stato\" for \"stateful\".",
          "anchor": "term-state-stateful"
        },
        {
          "en": "scope",
          "target": "scope",
          "use": "en",
          "notes": "Kept English, matching the pattern used for Hungarian and French. Where the source `<define>`s it, gloss as _ambito (di visibilità)_, then use _scope_.",
          "anchor": "term-scope"
        },
        {
          "en": "class",
          "target": "classe",
          "use": "it",
          "anchor": "term-class"
        },
        {
          "en": "method",
          "target": "metodo",
          "use": "it",
          "anchor": "term-method"
        },
        {
          "en": "property",
          "target": "proprietà",
          "use": "it",
          "anchor": "term-property"
        },
        {
          "en": "object",
          "target": "oggetto",
          "use": "it",
          "anchor": "term-object"
        }
      ]
    },
