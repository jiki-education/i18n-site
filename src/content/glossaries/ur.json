          "use": "ur",
          "notes": "Literally \"key word\"; native compound.",
          "anchor": "term-keyword"
        },
        {
          "en": "variable",
          "target": "متغیر",
          "use": "ur",
          "notes": "The standard term taught in Pakistani computer-science curricula, not just a Wikipedia-only coinage.",
          "anchor": "term-variable"
        },
        {
          "en": "assignment",
          "target": "تفویض",
          "use": "ur",
          "notes": "Native word meaning \"assignment/delegation,\" used for the concept of giving a variable its value.",
          "anchor": "term-assignment"
        },
        {
          "en": "to assign",
          "target": "تفویض کرنا",
          "use": "ur",
          "notes": "Light verb built from the noun above.",
          "anchor": "term-to-assign"
        },
        {
          "en": "code block",
          "target": "کوڈ بلاک",
          "use": "ur",
          "notes": "\"کوڈ\" (code, never translated) + \"بلاک\" (transliterated \"block\"). Self-explanatory once both halves are known.",
          "anchor": "term-code-block"
        },
        {
          "en": "error",
          "target": "غلطی",
          "use": "ur",
          "notes": "Ordinary Urdu word for \"mistake/error.\" Matches Jiki's non-blaming tone well.",
          "anchor": "term-error"
        },
        {
          "en": "nested",
          "target": "تہہ در تہہ",
          "use": "ur",
          "notes": "Native descriptive phrase, \"layer within layer.\" e.g. \"تہہ در تہہ لوپ\" = nested loop.",
          "anchor": "term-nested"
        },
        {
          "en": "iteration",
          "target": "تکرار",
          "use": "ur",
          "notes": "Native word meaning \"repetition.\"",
          "anchor": "term-iteration"
        },
        {
          "en": "to run / execute (code)",
          "target": "چلانا",
          "use": "ur",
          "notes": "Ordinary Urdu verb, \"to run/operate.\"",
          "anchor": "term-to-run-execute"
        },
        {
          "en": "loop",
          "target": "لوپ",
          "use": "ur",
          "notes": "Transliterated loanword, standard in Pakistani CS teaching.",
          "anchor": "term-loop"
        },
        {
          "en": "for loop",
          "target": "for لوپ",
          "use": "ur",
          "notes": "Keep `for` in code font (real keyword) + transliterated \"لوپ\".",
          "anchor": "term-for-loop"
        },
        {
          "en": "while loop",
          "target": "while لوپ",
          "use": "ur",
          "notes": "As above, with `while`.",
          "anchor": "term-while-loop"
        },
        {
          "en": "loop body",
          "target": "لوپ کا اندرونی حصہ",
          "use": "ur",
          "notes": "\"The loop's inner part,\" descriptive.",
          "anchor": "term-loop-body"
        },
        {
          "en": "scope",
          "target": "دائرہ کار",
          "use": "ur",
          "notes": "Native compound meaning \"scope of work/jurisdiction,\" well established in formal Urdu. Keep distinct from \"کوڈ بلاک\" (code block) above, matching the distinction in `global/terms.md`.",
          "anchor": "term-scope"
        },
        {
          "en": "class",
          "target": "کلاس",
          "use": "ur",
          "notes": "Transliterated loanword, standard in Pakistani CS teaching.",
          "anchor": "term-class"
        },
        {
          "en": "method",
          "target": "میتھڈ",
          "use": "ur",
          "notes": "Transliterated loanword, kept distinct from the generic Urdu word for \"way/method\" to avoid ambiguity in technical prose.",
          "anchor": "term-method"
        },
        {
          "en": "property",
          "target": "خاصیت",
          "use": "ur",
          "notes": "Native word meaning \"property/attribute/characteristic,\" well established. Keep distinct from \"خصوصیت\" (feature, platform sense) below; these are related but different words.",
          "anchor": "term-property"
        },
        {
          "en": "object",
          "target": "آبجیکٹ",
          "use": "ur",
          "notes": "Transliterated loanword, standard in Pakistani CS teaching.",
          "anchor": "term-object"
        }
      ]
    },
