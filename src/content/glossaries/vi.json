  "sections": [
    {
      "title": "Core decisions",
      "level": 2,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "programming / coding",
          "target": "lập trình",
          "use": "vi",
          "notes": "\"Coding\" specifically is often rendered \"viết code\" colloquially; use lập trình as the consistent prose term regardless.",
          "anchor": "term-programming-coding"
        },
        {
          "en": "developer",
          "target": "lập trình viên",
          "use": "vi",
          "notes": "\"Dev\" is common in speech but lập trình viên is the standard written form.",
          "anchor": "term-developer"
        },
        {
          "en": "streak",
          "target": "streak",
          "use": "en",
          "notes": "Where the source `<define>`s it, gloss as \"chuỗi ngày học liên tục.\" English \"streak\" is dominant even in otherwise-Vietnamese prose (\"giữ streak\").",
          "anchor": "term-streak"
        },
        {
          "en": "tech / tech industry",
          "target": "ngành công nghệ",
          "use": "vi",
          "notes": "\"IT\"/\"ngành IT\" is a common alternative; do not mix both in one document.",
          "anchor": "term-tech-tech-industry"
        },
        {
          "en": "pitfall",
          "target": "lỗi thường gặp",
          "use": "vi",
          "notes": "Ordinary phrase; stands alone.",
          "anchor": "term-pitfall"
        }
      ]
    },
    {
      "title": "Values & data types",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "value",
          "target": "giá trị",
          "use": "vi",
          "notes": "Ordinary word.",
          "anchor": "term-value"
        },
        {
          "en": "number",
          "target": "số",
          "use": "vi",
          "notes": "Ordinary word.",
          "anchor": "term-number"
        },
        {
          "en": "true / false",
          "target": "đúng / sai",
          "use": "vi",
          "notes": "The literals `true`/`false` in code stay in code font; this is the prose concept.",
          "anchor": "term-true-false"
        },
        {
          "en": "character",
          "target": "ký tự",
          "use": "vi",
          "notes": "`char` is the type name in code.",
          "anchor": "term-character"
        },
        {
          "en": "integer",
          "target": "số nguyên",
          "use": "vi",
          "notes": "`int` is the type name in code.",
          "anchor": "term-integer"
        },
        {
          "en": "float / decimal",
          "target": "số thực",
          "use": "vi",
          "notes": "`float`/`double` are the type names in code.",
          "anchor": "term-float-decimal"
        },
        {
          "en": "array",
          "target": "mảng",
          "use": "vi",
          "anchor": "term-array"
        },
        {
          "en": "dictionary",
          "target": "từ điển",
          "use": "vi",
          "notes": "Python-specific prose may keep \"dict\"; do not mix both in one document without a reason tied to the source.",
          "anchor": "term-dictionary"
        },
        {
          "en": "element",
          "target": "phần tử",
          "use": "vi",
          "notes": "Array element = \"phần tử của mảng\".",
          "anchor": "term-element"
        },
        {
          "en": "index",
          "target": "chỉ số",
          "use": "vi",
          "anchor": "term-index"
        },
        {
          "en": "key-value pair",
          "target": "cặp khóa-giá trị",
          "use": "vi",
          "anchor": "term-key-value-pair"
        },
        {
          "en": "string",
          "target": "chuỗi",
          "use": "vi",
          "notes": "Not \"xâu\" (dated, competitive-programming register; do not use for beginner content).",
          "anchor": "term-string"
        },
        {
          "en": "Boolean",
          "target": "kiểu logic",
          "use": "vi",
          "notes": "The concept name; the literal type name `bool`/`Boolean` in code stays as-is.",
          "anchor": "term-boolean"
        }
      ]
    },
    {
