    {
      "title": "Functions & control flow",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "if statement",
          "target": "условная конструкция",
          "use": "ru",
          "notes": "Avoid \"оператор\" here, it's reserved for the operator sense below.",
          "anchor": "term-if-statement"
        },
        {
          "en": "condition",
          "target": "условие",
          "use": "ru",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-condition"
        },
        {
          "en": "comparison",
          "target": "сравнение",
          "use": "ru",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-comparison"
        },
        {
          "en": "expression",
          "target": "выражение",
          "use": "ru",
          "anchor": "term-expression"
        },
        {
          "en": "operator",
          "target": "оператор",
          "use": "ru",
          "notes": "Reserve exclusively for the symbol sense (`+`, `===`); never use for \"statement.\"",
          "anchor": "term-operator"
        },
        {
          "en": "statement (executable)",
          "target": "инструкция",
          "use": "ru",
          "notes": "The imperative sense: a line of code that does something. Deliberately distinct from `оператор` to avoid the classic RU CS collision (older sources like GOST 28397-89 use \"оператор\" for both senses; Jiki keeps them separate).",
          "anchor": "term-statement"
        },
        {
          "en": "statement (logical claim)",
          "target": "утверждение",
          "use": "ru",
          "notes": "The proposition sense: a claim that is true or false; also a test assertion.",
          "anchor": "term-statement-2"
        },
        {
          "en": "function",
          "target": "функция",
          "use": "ru",
          "notes": "The *keyword* `function` in code stays English; the concept in prose is _функция_.",
          "anchor": "term-function"
        },
        {
          "en": "to call (a function)",
          "target": "вызвать (функцию)",
          "use": "ru",
          "anchor": "term-to-call"
        },
        {
          "en": "to define (a function)",
          "target": "определить (функцию)",
          "use": "ru",
          "anchor": "term-to-define"
        },
        {
          "en": "input (to a function)",
          "target": "вход / входные данные",
          "use": "ru",
          "notes": "Pairs with the `машина`/`автомат` metaphor family below.",
          "anchor": "term-input"
        },
        {
          "en": "output",
          "target": "выход / выходные данные",
          "use": "ru",
          "anchor": "term-output"
        },
        {
          "en": "to return (a value)",
          "target": "вернуть (значение)",
          "use": "ru",
          "anchor": "term-to-return"
        },
        {
          "en": "return value",
          "target": "возвращаемое значение",
          "use": "ru",
          "anchor": "term-return-value"
        }
      ]
    },
