---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ReviewCountBadge from "../components/ReviewCountBadge.astro";
import { languageFlag, languageMeta } from "../lib/languages";
import { languageReviewTargets } from "../lib/review-targets";

const REQUEST_THREAD = "https://forum.jiki.io/t/request-a-new-language-for-translation/714";

const glossaries = await getCollection("glossaries");
const translations = await getCollection("translations");

const languages = glossaries
  .map((glossary) => {
    const lang = glossary.data.lang;
    const items = translations.filter((t) => t.data.lang === lang);
    return {
      lang,
      meta: languageMeta(lang),
      flag: languageFlag(lang),
      termCount: glossary.data.term_count ?? 0,
      reviewTargets: languageReviewTargets(lang, glossary.data, items)
    };
  })
  .sort((a, b) => a.meta.name.localeCompare(b.meta.name));
---

<Layout title="Languages" description={`Jiki and Exercism are being translated into ${languages.length} languages. Pick yours, read the glossary, and tell us what sounds wrong.`}>
  <PageHeader title="Languages" subtitle={`We're translating into ${languages.length} languages. Pick yours to read its glossary and whatever has been translated so far.`} crumbs={[{ label: "Home", href: "/" }, { label: "Languages" }]} />

  <div class="lg-container py-10">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        languages.map(({ lang, meta, flag, termCount, reviewTargets }) => (
          <li>
            <a href={`/${lang}`} class="flex h-full items-start gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-purple-300 hover:shadow-md">
              <span class="text-[28px] leading-none" aria-hidden="true">
                {flag}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[17px] font-bold text-blue-600">{meta.name}</span>
                <span class="mt-0.5 block text-[14px] text-gray-500" lang={lang} dir={meta.dir}>
                  {meta.nativeName}
                </span>
                <span class="mt-3 flex flex-wrap items-center gap-2 text-[12px]">
                  <span class="rounded-full bg-gray-100 px-2 py-0.5 font-semibold text-gray-600">{termCount} terms</span>
                  <ReviewCountBadge targets={reviewTargets} format="phrase" class="rounded-full bg-emerald-50 px-2 py-0.5 font-semibold text-emerald-700" />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 max-w-2xl rounded-2xl border border-gray-200 bg-gray-50 p-6">
      <h2 class="text-[19px] font-bold text-gray-900">Not seeing your language?</h2>
      <p class="mt-2 text-[15px] text-gray-600">Ask for it and we'll bootstrap it: a forum category for your language and a starting glossary to argue with. Bring other native speakers if you can, because the more people checking a language, the better it ends up.</p>
      <a href={REQUEST_THREAD} class="mt-4 inline-block rounded-lg bg-purple-600 px-5 py-2.5 text-[15px] font-semibold text-white transition hover:bg-purple-700"> Request a language </a>
    </div>
  </div>
</Layout>
