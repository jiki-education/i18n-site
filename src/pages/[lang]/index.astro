---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ReviewBadge from "../../components/ReviewBadge.astro";
import PinToggle from "../../components/PinToggle.astro";
import { contentTypeLabel, forumCategoryUrl, languageMeta, stageMeta } from "../../lib/languages";
import { reviewItemId } from "../../lib/reviewed";
import { playerReviewVersion } from "../../lib/videojs";

export const getStaticPaths = (async () => {
  const glossaries = await getCollection("glossaries");
  return glossaries.map((glossary) => ({
    params: { lang: glossary.data.lang },
    props: { glossary }
  }));
}) satisfies GetStaticPaths;

const { glossary } = Astro.props;
const lang = glossary.data.lang;
const meta = languageMeta(lang);

const translations = (await getCollection("translations")).filter((t) => t.data.lang === lang).sort((a, b) => a.data.slug.localeCompare(b.data.slug));

const published = translations.filter((t) => t.data.status === "published");
const planned = translations.filter((t) => t.data.status === "planned");
const termCount = glossary.data.term_count ?? 0;
const stage = stageMeta(glossary.data.stage);

const byType = new Map<string, typeof translations>();
for (const item of translations) {
  const list = byType.get(item.data.type) ?? [];
  list.push(item);
  byType.set(item.data.type, list);
}
---

<Layout title={`${meta.name} (${lang})`} description={`Jiki and Exercism translated into ${meta.name}: ${termCount} agreed terms and ${published.length} published translations, all open for comment.`}>
  <PageHeader title={meta.name} subtitle={`Jiki and Exercism in ${meta.name}. Everything here is a draft, and all of it is open for comment.`} crumbs={[{ label: "Home", href: "/" }, { label: "Languages", href: "/languages" }, { label: meta.name }]}>
    <div slot="meta" class="mt-6 flex flex-wrap gap-3">
      <a href={forumCategoryUrl(lang)} class="rounded-lg bg-white px-4 py-2.5 text-[15px] font-semibold text-purple-800 transition hover:bg-purple-100"> Discuss on the forum </a>
      <PinToggle lang={lang} />
    </div>

    <dl slot="aside" class="space-y-3 rounded-2xl border border-purple-700 bg-purple-950/40 p-5 text-[14px]">
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-purple-300">Stage</dt>
        <dd class="font-semibold text-white">{stage.label} ({stage.number})</dd>
      </div>
      <p class="-mt-[13px] ml-auto max-w-[250px] text-right text-[12px] leading-snug text-purple-300">{stage.blurb}</p>
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-purple-300">Agreed terms</dt>
        <dd class="font-semibold text-white">{termCount}</dd>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-purple-300">Published</dt>
        <dd class="font-semibold text-white">{published.length}</dd>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-purple-300">Queued</dt>
        <dd class="font-semibold text-white">{planned.length}</dd>
      </div>
      {
        glossary.data.family && (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-purple-300">Shares terms with</dt>
            <dd class="font-semibold text-white">{glossary.data.family.toUpperCase()} family</dd>
          </div>
        )
      }
    </dl>
  </PageHeader>

  <div class="lg-container grid gap-10 py-10 lg:grid-cols-[1fr_350px] lg:gap-[7%]">
    <div class="min-w-0">
      <div class="textual-content">
        <h2>Things to check</h2>
        {published.length === 0 && <p>Nothing published in {meta.name} yet beyond the glossary. Terms are agreed first, then translations start appearing here for you to pull apart. The items below are queued.</p>}
      </div>

      <div class="mt-6 space-y-8">
        <section>
          <h3 class="text-[13px] font-bold tracking-[0.08em] text-gray-500 uppercase">Foundations</h3>
          <ul class="mt-3 space-y-2">
            <li>
              <a href={`/${lang}/glossary`} class="flex items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white px-5 py-4 transition hover:-translate-y-0.5 hover:border-purple-300 hover:shadow-md">
                <span class="min-w-0">
                  <span class="block font-semibold text-gray-900">Glossary</span>
                  <span class="mt-0.5 block text-[13px] text-gray-500">The {termCount} agreed terms every translation is built on</span>
                </span>
                <ReviewBadge itemId={reviewItemId(lang, "glossary")} version={glossary.data.content_version ?? glossary.data.governance_sha} />
              </a>
            </li>
            <li>
              <a href={`/${lang}/video-player`} class="flex items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white px-5 py-4 transition hover:-translate-y-0.5 hover:border-purple-300 hover:shadow-md">
                <span class="min-w-0">
                  <span class="block font-semibold text-gray-900">Video player</span>
                  <span class="mt-0.5 block text-[13px] text-gray-500">The controls and captions wrapped around every video</span>
                </span>
                <ReviewBadge itemId={reviewItemId(lang, "video-player")} version={playerReviewVersion(lang)} />
              </a>
            </li>
          </ul>
        </section>

        {
          [...byType.entries()].map(([type, items]) => (
            <section>
              <h3 class="text-[13px] font-bold tracking-[0.08em] text-gray-500 uppercase">{contentTypeLabel(type)}</h3>
              <ul class="mt-3 space-y-2">
                {items.map((item) =>
                  item.data.status === "published" ? (
                    <li>
                      <a href={`/${lang}/${item.data.type}/${item.data.slug}`} class="flex items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white px-5 py-4 transition hover:-translate-y-0.5 hover:border-purple-300 hover:shadow-md">
                        <span class="min-w-0">
                          <span class="block font-semibold text-gray-900" lang={lang} dir={meta.dir}>
                            {item.data.title ?? item.data.slug}
                          </span>
                          <span class="mt-0.5 block text-[13px] text-gray-500">{item.data.slug}</span>
                        </span>
                        <ReviewBadge itemId={reviewItemId(lang, item.data.type, item.data.slug)} version={item.data.content_version ?? item.data.en_md5 ?? "unknown"} />
                      </a>
                    </li>
                  ) : (
                    <li class="flex items-center justify-between gap-4 rounded-xl border border-dashed border-gray-300 bg-gray-50 px-5 py-4">
                      <span class="min-w-0">
                        <span class="block font-semibold text-gray-500">{item.data.slug}</span>
                        <span class="mt-0.5 block text-[13px] text-gray-400">Not translated yet</span>
                      </span>
                      <span class="shrink-0 rounded-full bg-white px-2.5 py-1 text-[12px] font-semibold text-gray-500" lang={lang} dir={meta.dir}>
                        {meta.comingSoon}
                      </span>
                    </li>
                  )
                )}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="textual-content mt-10">
        <h2>How to help</h2>
        <p>
          Read anything above in {meta.name} and tell us where it sounds wrong. You don't need to explain why, and you don't need to be technical. Post it in <a href={forumCategoryUrl(lang)}>the {meta.name} forum category</a>, because that's what we feed back into the translations.
        </p>
        <p>
          If a term itself is wrong (not just this sentence, but the word we use everywhere), take it to <a href={`/${lang}/glossary`}>the glossary</a> instead. Fixing it there fixes it everywhere at once.
        </p>
      </div>
    </div>

    <aside class="min-w-0 space-y-6">
      <section class="rounded-2xl border border-gray-200 bg-white p-5">
        <h2 class="text-[13px] font-bold tracking-[0.08em] text-gray-500 uppercase">Quick links</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a href={forumCategoryUrl(lang)} class="-mx-2 block rounded-lg px-2 py-2 transition hover:bg-purple-50">
              <span class="block text-[15px] font-semibold text-blue-600">{meta.name} on the forum</span>
              <span class="block text-[13px] text-gray-500">Where this language gets decided</span>
            </a>
          </li>
          <li>
            <a href="https://discord.gg/JFty3vbqRZ" class="-mx-2 block rounded-lg px-2 py-2 transition hover:bg-purple-50">
              <span class="block text-[15px] font-semibold text-blue-600">Discord</span>
              <span class="block text-[13px] text-gray-500">Work with other speakers in real time</span>
            </a>
          </li>
          <li>
            <a href="/languages" class="-mx-2 block rounded-lg px-2 py-2 transition hover:bg-purple-50">
              <span class="block text-[15px] font-semibold text-blue-600">All languages</span>
              <span class="block text-[13px] text-gray-500">Back to the full list</span>
            </a>
          </li>
        </ul>
      </section>
    </aside>
  </div>
</Layout>
