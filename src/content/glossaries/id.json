{
  "lang": "id",
  "name": "Indonesian",
  "family": null,
  "governance_sha": "0349487",
  "published_at": "2026-07-28",
  "sections": [
    {
      "title": "Core decisions",
      "level": 2,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "programming / coding",
          "target": "pemrograman",
          "use": "id",
          "notes": "Standard, formal-but-natural term used throughout academic and dev sources (Munir/ITB, Dicoding). `koding`/`ngoding` is acceptable only when the source specifically stresses the casual act of writing code (Dicoding's own blog post is titled \"Apa itu Coding\"); never mix both in one document.",
          "anchor": "term-programming-coding"
        },
        {
          "en": "developer",
          "target": "developer",
          "use": "id",
          "notes": "Extremely common as a loanword in Indonesian tech media and dev tutorials. Where the source `<define>`s it, gloss the native _pengembang_.",
          "anchor": "term-developer"
        }
      ]
    },
    {
      "title": "Values & data types",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "value",
          "target": "nilai",
          "use": "id",
          "notes": "Ordinary word.",
          "anchor": "term-value"
        },
        {
          "en": "number",
          "target": "angka",
          "use": "id",
          "notes": "Use `angka` for the general sense; `bilangan` also appears but `angka` is the more natural default in tutorial prose.",
          "anchor": "term-number"
        },
        {
          "en": "character",
          "target": "karakter",
          "use": "id",
          "notes": "Naturalized.",
          "anchor": "term-character"
        },
        {
          "en": "true / false",
          "target": "benar / salah",
          "use": "id",
          "notes": "Used when explaining the concept; the literals `True`/`False` in code stay as code.",
          "anchor": "term-true-false"
        },
        {
          "en": "integer",
          "target": "bilangan bulat",
          "use": "id",
          "notes": "The keyword `int` in code stays English; the concept in prose is _bilangan bulat_.",
          "anchor": "term-integer"
        },
        {
          "en": "float / decimal",
          "target": "bilangan pecahan",
          "use": "id",
          "notes": "Or _bilangan riil_ if the real-number nature matters more than the fractional one. No single fixed official term; pick one per document and stay consistent.",
          "anchor": "term-float-decimal"
        },
        {
          "en": "element",
          "target": "elemen",
          "use": "id",
          "notes": "Naturalized.",
          "anchor": "term-element"
        },
        {
          "en": "index",
          "target": "indeks",
          "use": "id",
          "notes": "Naturalized; both `index` and `indeks` spellings are seen, but `indeks` is the Indonesian-orthography form.",
          "anchor": "term-index"
        },
        {
          "en": "key-value pair",
          "target": "pasangan kunci-nilai",
          "use": "id",
          "anchor": "term-key-value-pair"
        }
      ]
    },
    {
      "title": "Functions & control flow",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "condition",
          "target": "kondisi",
          "use": "id",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-condition"
        },
        {
          "en": "comparison",
          "target": "perbandingan",
          "use": "id",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-comparison"
        },
        {
          "en": "expression",
          "target": "ekspresi",
          "use": "id",
          "notes": "Naturalized.",
          "anchor": "term-expression"
        },
        {
          "en": "operator",
          "target": "operator",
          "use": "id",
          "notes": "Naturalized loan, identical spelling.",
          "anchor": "term-operator"
        },
        {
          "en": "statement (executable)",
          "target": "pernyataan",
          "use": "id",
          "notes": "The imperative sense: a line of code that does something and gets executed.",
          "anchor": "term-statement"
        },
        {
          "en": "statement (logical claim)",
          "target": "pernyataan",
          "use": "id",
          "notes": "The proposition sense: a claim that is true or false. Same Indonesian word as the executable sense above; pick by context, English distinguishes these but Indonesian does not have a clean second word.",
          "anchor": "term-statement-2"
        },
        {
          "en": "if statement",
          "target": "percabangan if",
          "use": "id",
          "notes": "Keep the `if` keyword in code font; translate only \"percabangan\".",
          "anchor": "term-if-statement"
        },
        {
          "en": "function",
          "target": "fungsi",
          "use": "id",
          "notes": "The *keyword* `function` in code stays English; the concept in prose is _fungsi_.",
          "anchor": "term-function"
        },
        {
          "en": "to call (a function)",
          "target": "memanggil (fungsi)",
          "use": "id",
          "anchor": "term-to-call"
        },
        {
          "en": "to define (a function)",
          "target": "mendefinisikan / membuat (fungsi)",
          "use": "id",
          "notes": "Either is natural; stay consistent within a document.",
          "anchor": "term-to-define"
        },
        {
          "en": "parameter",
          "target": "parameter",
          "use": "id",
          "notes": "Naturalized loan, identical spelling. Only worth glossing where the source `<define>`s it alongside `argumen`; otherwise self-explanatory.",
          "anchor": "term-parameter"
        },
        {
          "en": "argument",
          "target": "argumen",
          "use": "id",
          "notes": "Naturalized spelling (not `argument`). Distinguish from `parameter` where the two are introduced together.",
          "anchor": "term-argument"
        },
        {
          "en": "input (to a function)",
          "target": "input",
          "use": "en",
          "notes": "Where the source `<define>`s it, gloss _masukan_, then use `input`.",
          "anchor": "term-input"
        },
        {
          "en": "output",
          "target": "output",
          "use": "en",
          "notes": "Where the source `<define>`s it, gloss _keluaran_, then use `output`.",
          "anchor": "term-output"
        },
        {
          "en": "to return (a value)",
          "target": "mengembalikan",
          "use": "id",
          "notes": "\"Fungsi ini mengembalikan sebuah nilai.\"",
          "anchor": "term-to-return"
        },
        {
          "en": "return value",
          "target": "nilai kembalian",
          "use": "id",
          "notes": "Keep distinct from the verb above.",
          "anchor": "term-return-value"
        }
      ]
    },
    {
      "title": "Loops, state & program flow",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "keyword",
          "target": "kata kunci",
          "use": "id",
          "notes": "Ordinary compound; stands alone.",
          "anchor": "term-keyword"
        },
        {
          "en": "variable",
          "target": "variabel",
          "use": "id",
          "notes": "Real developers use `variabel`, not the official/academic coinage `peubah` (essentially unused outside textbooks).",
          "anchor": "term-variable"
        },
        {
          "en": "assignment",
          "target": "assignment",
          "use": "en",
          "notes": "Kept English in dev prose (`memberikan nilai` as a paraphrase is also fine for the verb, see below). Where the source `<define>`s the noun, gloss _pengisian nilai_.",
          "anchor": "term-assignment"
        },
        {
          "en": "to assign",
          "target": "memberikan nilai / menginisialisasi",
          "use": "id",
          "notes": "Verb form; prefer this over a bare loanword.",
          "anchor": "term-to-assign"
        },
        {
          "en": "code block",
          "target": "blok kode",
          "use": "id",
          "anchor": "term-code-block"
        },
        {
          "en": "error",
          "target": "error",
          "use": "en",
          "notes": "Kept in code/debugging contexts; use _kesalahan_ when explaining the general concept in plain prose. Do not use _galat_ (localization-standard term, but inconsistently applied even in official Indonesian software localization; avoid it here for consistency).",
          "anchor": "term-error"
        },
        {
          "en": "nested",
          "target": "bersarang",
          "use": "id",
          "notes": "e.g. _perulangan bersarang_ = nested loop.",
          "anchor": "term-nested"
        },
        {
          "en": "iteration",
          "target": "iterasi",
          "use": "id",
          "notes": "Naturalized; verb form _mengiterasi_ is used but less common than just describing the loop.",
          "anchor": "term-iteration"
        },
        {
          "en": "to run / execute (code)",
          "target": "menjalankan",
          "use": "id",
          "anchor": "term-to-run-execute"
        },
        {
          "en": "loop",
          "target": "perulangan",
          "use": "id",
          "notes": "Real developers use `perulangan`, not the official coinage `gelung` (essentially unused).",
          "anchor": "term-loop"
        },
        {
          "en": "for loop",
          "target": "perulangan for",
          "use": "id",
          "notes": "Keep the `for` keyword in code font; translate only \"perulangan.\"",
          "anchor": "term-for-loop"
        },
        {
          "en": "while loop",
          "target": "perulangan while",
          "use": "id",
          "notes": "As above, with `while`.",
          "anchor": "term-while-loop"
        },
        {
          "en": "scope",
          "target": "scope",
          "use": "en",
          "notes": "Where the source `<define>`s it, gloss _cakupan_, then use `scope`.",
          "anchor": "term-scope"
        },
        {
          "en": "class",
          "target": "class / kelas",
          "use": "id",
          "notes": "Both forms are genuinely mixed in real Indonesian dev writing. Pick one per document and stay consistent within it; do not mix both in the same file.",
          "anchor": "term-class"
        },
        {
          "en": "method",
          "target": "method",
          "use": "en",
          "notes": "Kept English in dev prose; `metode` (the formal/dictionary form) reads too formal for this context.",
          "anchor": "term-method"
        },
        {
          "en": "property",
          "target": "properti",
          "use": "id",
          "notes": "Naturalized.",
          "anchor": "term-property"
        },
        {
          "en": "object",
          "target": "objek",
          "use": "id",
          "notes": "Naturalized; `object` also appears but `objek` is the Indonesian-orthography default.",
          "anchor": "term-object"
        }
      ]
    },
    {
      "title": "Tooling & engineering",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "workflow",
          "target": "alur kerja",
          "use": "id",
          "anchor": "term-workflow"
        },
        {
          "en": "algorithm",
          "target": "algoritma",
          "use": "id",
          "notes": "Naturalized, universal.",
          "anchor": "term-algorithm"
        },
        {
          "en": "module",
          "target": "modul",
          "use": "id",
          "notes": "Naturalized, universal.",
          "anchor": "term-module"
        },
        {
          "en": "auth (authentication / authorization)",
          "target": "autentikasi",
          "use": "id",
          "notes": "Covers the login/identity sense; use _otorisasi_ only when the permissions sense specifically is meant.",
          "anchor": "term-auth"
        },
        {
          "en": "deploy",
          "target": "deploy",
          "use": "en",
          "notes": "Kept English as a verb in dev prose (dominant real usage); where the source `<define>`s it, gloss _menerapkan_.",
          "anchor": "term-deploy"
        },
        {
          "en": "tool / tooling",
          "target": "alat",
          "use": "id",
          "notes": "`alat` is the natural base word; `tool`/`tools` also appears as a loanword in casual developer prose.",
          "anchor": "term-tool-tooling"
        }
      ]
    },
    {
      "title": "Platform & curriculum vocabulary",
      "level": 2,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "lesson",
          "target": "materi",
          "use": "id",
          "notes": "Matches Dicoding's platform-native term for a lesson/reading unit; `pelajaran` reads more school-flavoured.",
          "anchor": "term-lesson"
        },
        {
          "en": "exercise",
          "target": "latihan",
          "use": "id",
          "notes": "`soal` is narrower (\"problem/question\"); use `latihan` for the exercise as a whole.",
          "anchor": "term-exercise"
        },
        {
          "en": "curriculum",
          "target": "kurikulum",
          "use": "id",
          "notes": "The whole program.",
          "anchor": "term-curriculum"
        },
        {
          "en": "syllabus",
          "target": "silabus",
          "use": "id",
          "notes": "A single course's outline, distinct from `kurikulum`.",
          "anchor": "term-syllabus"
        },
        {
          "en": "level",
          "target": "level",
          "use": "en",
          "notes": "Kept English in dev-platform UI (e.g. \"Level Dasar/Pemula\"); `tingkat` is an acceptable native alternative if a document leans more formal.",
          "anchor": "term-level"
        },
        {
          "en": "mentor / mentoring",
          "target": "mentor",
          "use": "en",
          "notes": "Kept English; `pembimbing` is a workable native alternative but `mentor` is dominant in real platform usage.",
          "anchor": "term-mentor-mentoring"
        },
        {
          "en": "track (curriculum path)",
          "target": "jalur",
          "use": "id",
          "notes": "e.g. _jalur belajar_ (learning path/track).",
          "anchor": "term-track"
        },
        {
          "en": "tutorial",
          "target": "tutorial",
          "use": "en",
          "notes": "Kept English for an interactive, step-by-step lesson; use `panduan` only for a static written guide, not an interactive tutorial.",
          "anchor": "term-tutorial"
        },
        {
          "en": "solution (learner's submission)",
          "target": "solusi / penyelesaian / jawaban",
          "use": "id",
          "notes": "Context-dependent: `solusi` in general, `penyelesaian` for a worked solution, `jawaban` for a quiz answer. Pick the right one per context; do not force a single word everywhere.",
          "anchor": "term-solution"
        }
      ]
    }
  ],
  "forum_topic_id": 325
}
