        "notes": 3
      },
      "terms": [
        {
          "en": "if statement",
          "target": "умовна конструкція / умовний оператор",
          "use": "uk",
          "notes": "Correction from an earlier community proposal (\"умовне твердження\"), which collided with the \"statement (logical claim)\" term.",
          "anchor": "term-if-statement"
        },
        {
          "en": "condition",
          "target": "умова",
          "use": "uk",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-condition"
        },
        {
          "en": "comparison",
          "target": "порівняння",
          "use": "uk",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-comparison"
        },
        {
          "en": "expression",
          "target": "вираз",
          "use": "uk",
          "anchor": "term-expression"
        },
        {
          "en": "operator",
          "target": "оператор",
          "use": "uk",
          "anchor": "term-operator"
        },
        {
          "en": "NOT operator / logical negation",
          "target": "заперечення (логічне)",
          "use": "uk",
          "anchor": "term-not-operator-logical-negation"
        },
        {
          "en": "statement (executable)",
          "target": "інструкція",
          "use": "uk",
          "notes": "The imperative sense: a line of code that does something and gets executed. Deliberately distinct from _оператор_ (operator) to avoid collision.",
          "anchor": "term-statement"
        },
        {
          "en": "statement (logical claim)",
          "target": "твердження",
          "use": "uk",
          "notes": "The proposition sense: a claim that is true or false. Pick by meaning, not by the English word.",
          "anchor": "term-statement-2"
        },
        {
          "en": "function",
          "target": "функція",
          "use": "uk",
          "notes": "The *keyword* `function` in code stays English; the concept in prose is _функція_.",
          "anchor": "term-function"
        },
        {
          "en": "to call (a function)",
          "target": "викликати (функцію)",
          "use": "uk",
          "anchor": "term-to-call"
        },
        {
          "en": "to define (a function)",
          "target": "визначати (функцію)",
          "use": "uk",
          "anchor": "term-to-define"
        },
        {
          "en": "parameter",
          "target": "параметр",
          "use": "uk",
          "anchor": "term-parameter"
        },
        {
          "en": "argument",
          "target": "аргумент",
          "use": "uk",
          "notes": "Call-site value sense.",
          "anchor": "term-argument"
        },
        {
          "en": "input (to a function)",
          "target": "вхідні дані",
          "use": "uk",
          "anchor": "term-input"
        },
        {
          "en": "output",
          "target": "вихідні дані",
          "use": "uk",
          "anchor": "term-output"
        },
        {
          "en": "to return (a value)",
          "target": "повернути (значення)",
          "use": "uk",
          "anchor": "term-to-return"
        },
        {
          "en": "return value",
          "target": "повернене значення",
          "use": "uk",
          "notes": "Noun form; distinct from the verb \"to return.\"",
          "anchor": "term-return-value"
        },
        {
          "en": "pure function",
          "target": "чиста функція",
          "use": "uk",
          "anchor": "term-pure-function"
        }
      ]
