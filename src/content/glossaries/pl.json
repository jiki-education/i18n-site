          "use": "pl",
          "notes": "Matches current Microsoft Polish UI terminology.",
          "anchor": "term-toggle"
        },
        {
          "en": "state / stateful",
          "target": "stan (noun) / stanowy, bezstanowy (adjective)",
          "use": "pl",
          "anchor": "term-state-stateful"
        },
        {
          "en": "class",
          "target": "klasa",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-class"
        },
        {
          "en": "method",
          "target": "metoda",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-method"
        },
        {
          "en": "property",
          "target": "właściwość",
          "use": "pl",
          "notes": "Use _pole_ or _atrybut_ instead for a raw Java field, if that distinction matters in context.",
          "anchor": "term-property"
        },
        {
          "en": "object",
          "target": "obiekt",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-object"
        },
        {
          "en": "encapsulation",
          "target": "enkapsulacja",
          "use": "pl",
          "notes": "`hermetyzacja` is an equally legitimate native alternative; not used here, for consistency with how other cognate CS loanwords are handled.",
          "anchor": "term-encapsulation"
        },
        {
