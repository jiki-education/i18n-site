---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ReviewToggle from "../../components/ReviewToggle.astro";
import { forumCategoryUrl, languageMeta } from "../../lib/languages";
import { reviewItemId } from "../../lib/reviewed";

export const getStaticPaths = (async () => {
  const glossaries = await getCollection("glossaries");
  return glossaries.map((glossary) => ({
    params: { lang: glossary.data.lang },
    props: { glossary }
  }));
}) satisfies GetStaticPaths;

const { glossary } = Astro.props;
const lang = glossary.data.lang;
const meta = languageMeta(lang);
const forumUrl = glossary.data.forum_topic_id ? `https://forum.jiki.io/t/${glossary.data.forum_topic_id}` : forumCategoryUrl(lang);

// Nothing to review until the translated player lands. The version is bumped by
// hand when it does, which sends everyone's "reviewed" mark back to unreviewed.
const version = "pending";
---

<Layout title={`${meta.name} video player`} description={`The Jiki video player in ${meta.name}. Coming soon, and open for comment when it lands.`}>
  <PageHeader title={`${meta.name} video player`} crumbs={[{ label: "Languages", href: "/" }, { label: meta.name, href: `/${lang}` }, { label: "Video player" }]} />

  <div class="lg-container grid gap-10 py-10 lg:grid-cols-[1fr_350px] lg:gap-[7%]">
    <div class="min-w-0">
      <div class="rounded-xl border border-purple-200 bg-purple-50 p-5">
        <p class="text-[15px] leading-[1.7] text-gray-700">The player wrapped around every Jiki video: its controls, its captions, and everything else you read while watching. Getting this right matters as much as the videos themselves, because it's on screen for every lesson.</p>
      </div>

      <div class="mt-8 rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-6 py-12 text-center">
        <p class="text-[17px] font-semibold text-gray-700" lang={lang} dir={meta.dir}>{meta.comingSoon}</p>
        <p class="mx-auto mt-2 max-w-md text-[15px] text-gray-500">
          Nothing to review here yet. It'll appear on this page once the {meta.name} player is generated, and you'll be able to pull it apart the same way as everything else.
        </p>
      </div>
    </div>

    <aside class="min-w-0 space-y-6">
      <section class="rounded-2xl border border-gray-200 bg-white p-5">
        <h2 class="text-[13px] font-bold tracking-[0.08em] text-gray-500 uppercase">Quick links</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a href={`/${lang}`} class="-mx-2 block rounded-lg px-2 py-2 transition hover:bg-purple-50">
              <span class="block text-[15px] font-semibold text-blue-600">Everything in {meta.name}</span>
              <span class="block text-[13px] text-gray-500">Back to the language page</span>
            </a>
          </li>
          <li>
            <a href={`/${lang}/glossary`} class="-mx-2 block rounded-lg px-2 py-2 transition hover:bg-purple-50">
              <span class="block text-[15px] font-semibold text-blue-600">The {meta.name} glossary</span>
              <span class="block text-[13px] text-gray-500">The terms this will be built on</span>
            </a>
          </li>
        </ul>

        <div class="mt-5 space-y-3 border-t border-gray-100 pt-4">
          <ReviewToggle itemId={reviewItemId(lang, "video-player")} version={version} class="w-full justify-center" />
          <a href={forumUrl} class="block rounded-lg bg-purple-600 px-4 py-2.5 text-center text-[15px] font-semibold text-white transition hover:bg-purple-700"> Discuss on the Forum </a>
        </div>
      </section>
    </aside>
  </div>
</Layout>
