      "terms": [
        {
          "en": "keyword",
          "target": "palabra clave",
          "use": "es",
          "anchor": "term-keyword"
        },
        {
          "en": "variable",
          "target": "variable",
          "use": "es",
          "notes": "Gender: _la variable_.",
          "anchor": "term-variable"
        },
        {
          "en": "assignment",
          "target": "asignación",
          "use": "es",
          "notes": "Noun.",
          "anchor": "term-assignment"
        },
        {
          "en": "to assign",
          "target": "asignar",
          "use": "es",
          "notes": "Verb; matches _asignación_ above.",
          "anchor": "term-to-assign"
        },
        {
          "en": "code block",
          "target": "bloque de código",
          "use": "es",
          "notes": "Deliberately distinct from _ámbito_ (scope).",
          "anchor": "term-code-block"
        },
        {
          "en": "error",
          "target": "error",
          "use": "es",
          "anchor": "term-error"
        },
        {
          "en": "nested",
          "target": "anidado",
          "use": "es",
          "notes": "e.g. _bucle anidado_ = nested loop.",
          "anchor": "term-nested"
        },
        {
          "en": "iteration",
          "target": "iteración",
          "use": "es",
          "notes": "Verb: _iterar_; _recorrer_ also natural.",
          "anchor": "term-iteration"
        },
        {
          "en": "to run / execute (code)",
          "target": "ejecutar",
          "use": "es",
          "anchor": "term-to-run-execute"
        },
        {
          "en": "loop",
          "target": "bucle",
          "use": "es",
          "notes": "Gender: _el bucle_. Not _ciclo_ (a common alternative not used here).",
          "anchor": "term-loop"
        },
        {
          "en": "for loop",
          "target": "bucle for",
          "use": "es",
          "notes": "Keep `for` in code font (real keyword) + _bucle_.",
          "anchor": "term-for-loop"
        },
        {
          "en": "while loop",
          "target": "bucle while",
          "use": "es",
          "notes": "As above. (The curriculum currently has no `while` loops, only `repeat`, `for`, `for-of`.)",
          "anchor": "term-while-loop"
        },
        {
          "en": "for-of loop",
          "target": "bucle for-of",
          "use": "es",
          "notes": "As above.",
          "anchor": "term-for-of-loop"
        },
        {
          "en": "loop body",
          "target": "cuerpo del bucle",
          "use": "es",
          "anchor": "term-loop-body"
        },
        {
          "en": "increment",
