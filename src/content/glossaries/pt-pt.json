      "terms": [
        {
          "en": "to return (a value)",
          "target": "devolver",
          "use": "pt-pt",
          "notes": "\"A função devolve um valor.\" European Portuguese idiom, confirmed against Univ. Évora course material (\"Devolve o valor...\"); deliberately diverges from Brazilian \"retornar\".",
          "anchor": "term-to-return"
        },
        {
          "en": "return value",
          "target": "valor devolvido",
          "use": "pt-pt",
          "notes": "Follows the verb `devolver` above.",
          "anchor": "term-return-value"
        }
