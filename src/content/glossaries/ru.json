      },
      "terms": [
        {
          "en": "value",
          "target": "значение",
          "use": "ru",
          "notes": "Ordinary word.",
          "anchor": "term-value"
        },
        {
          "en": "number",
          "target": "число",
          "use": "ru",
          "notes": "Ordinary word.",
          "anchor": "term-number"
        },
        {
          "en": "integer",
          "target": "целое число",
          "use": "ru",
          "anchor": "term-integer"
        },
        {
          "en": "float / decimal",
          "target": "дробное число",
          "use": "ru",
          "notes": "Use _число с плавающей точкой_ only when the floating-point behavior specifically matters.",
          "anchor": "term-float-decimal"
        },
        {
          "en": "character",
          "target": "символ",
          "use": "ru",
          "anchor": "term-character"
        },
        {
          "en": "true / false",
          "target": "true / false (keep English)",
          "use": "en",
          "notes": "These are the literal keywords learners type; _истина/ложь_ reads archaic and philosophical for this audience.",
          "anchor": "term-true-false"
        },
        {
          "en": "array / list",
          "target": "массив",
          "use": "ru",
          "notes": "Exercise prose that says \"list\" informally still renders as _массив_.",
          "anchor": "term-array-list"
        },
        {
          "en": "dictionary",
          "target": "словарь",
          "use": "ru",
          "anchor": "term-dictionary"
        },
        {
          "en": "element",
          "target": "элемент",
          "use": "ru",
          "notes": "Array element = _элемент массива_.",
          "anchor": "term-element"
        },
        {
          "en": "index",
          "target": "индекс",
          "use": "ru",
          "notes": "Same word; no clarification parens needed.",
          "anchor": "term-index"
        },
        {
          "en": "key-value pair",
          "target": "пара «ключ-значение»",
          "use": "ru",
          "notes": "Standard phrasing.",
          "anchor": "term-key-value-pair"
        },
        {
          "en": "string",
          "target": "строка",
          "use": "ru",
          "notes": "Fully native term; unlike Hungarian/Serbian, Russian does **not** keep \"string\" in English.",
          "anchor": "term-string"
        },
        {
          "en": "Boolean",
          "target": "логическое значение",
          "use": "ru",
          "notes": "Beginner-friendly native rendering. _Булево значение_ is a common dev-community alternative; do not mix the two within a document.",
          "anchor": "term-boolean"
        },
        {
          "en": "data type",
          "target": "тип данных",
          "use": "ru",
          "anchor": "term-data-type"
