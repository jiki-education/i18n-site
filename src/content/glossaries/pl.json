  "sections": [
    {
      "title": "Core decisions",
      "level": 2,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "programming",
          "target": "programowanie",
          "use": "pl",
          "notes": "Default, neutral term. Use consistently.",
          "anchor": "term-programming"
        },
        {
          "en": "coding (informal)",
          "target": "kodowanie",
          "use": "pl",
          "notes": "Use only when the source specifically stresses the casual, hands-on act of writing code. Never mix both in one document.",
          "anchor": "term-coding"
        },
        {
          "en": "tech / tech industry",
          "target": "branża IT",
          "use": "pl",
          "notes": "Standard in Polish tech writing.",
          "anchor": "term-tech-tech-industry"
        },
        {
          "en": "developer",
          "target": "programista",
          "use": "pl",
          "notes": "Standard, gender-neutral-reading term. Do not use `deweloper`, which in general Polish usage means a real-estate developer.",
          "anchor": "term-developer"
        },
        {
          "en": "streak",
          "target": "seria",
          "use": "pl",
          "notes": "Confirmed via Duolingo's own Polish product terminology (a comparable gamified daily-habit-learning product).",
          "anchor": "term-streak"
        },
        {
          "en": "pitfall",
          "target": "pułapka",
          "use": "pl",
          "notes": "Ordinary, idiomatic word; used this way in Polish IT writing.",
          "anchor": "term-pitfall"
        }
      ]
    },
    {
      "title": "Values & data types",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "value",
          "target": "wartość",
          "use": "pl",
          "notes": "Ordinary word.",
          "anchor": "term-value"
        },
        {
          "en": "number",
          "target": "liczba",
          "use": "pl",
          "notes": "Ordinary word.",
          "anchor": "term-number"
        },
        {
          "en": "integer",
          "target": "liczba całkowita",
          "use": "pl",
          "notes": "The keyword `int` in code stays English.",
          "anchor": "term-integer"
        },
        {
          "en": "float / decimal",
          "target": "liczba zmiennoprzecinkowa",
          "use": "pl",
          "notes": "The keywords `float`/`double` in code stay English.",
          "anchor": "term-float-decimal"
        },
        {
          "en": "character",
          "target": "znak",
          "use": "pl",
          "notes": "The keyword `char` in code stays English.",
          "anchor": "term-character"
        },
        {
          "en": "true / false",
          "target": "prawda / fałsz",
          "use": "pl",
          "notes": "Not capitalised in prose. The keywords `true`/`false` in code stay English.",
          "anchor": "term-true-false"
        },
        {
          "en": "array / list",
          "target": "tablica",
          "use": "pl",
          "notes": "The unrivalled Polish CS term; do not use `łańcuch` for this.",
          "anchor": "term-array-list"
        },
        {
          "en": "dictionary",
          "target": "słownik",
          "use": "pl",
          "anchor": "term-dictionary"
        },
        {
          "en": "element",
          "target": "element",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-element"
        },
        {
          "en": "index",
          "target": "indeks",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-index"
        },
        {
          "en": "string",
          "target": "ciąg znaków",
          "use": "pl",
          "notes": "Deliberately not `łańcuch`, to keep it distinct from the \"chain\" array metaphor below.",
          "anchor": "term-string"
        },
        {
          "en": "data type",
          "target": "typ danych",
          "use": "pl",
          "notes": "The general concept.",
          "anchor": "term-data-type"
        }
      ]
    },
    {
      "title": "Functions & control flow",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "if statement",
          "target": "instrukcja warunkowa",
          "use": "pl",
          "notes": "The keyword `if` stays English in code.",
          "anchor": "term-if-statement"
        },
        {
          "en": "condition",
          "target": "warunek",
          "use": "pl",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-condition"
        },
        {
          "en": "comparison",
          "target": "porównanie",
          "use": "pl",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-comparison"
        },
        {
          "en": "expression",
          "target": "wyrażenie",
          "use": "pl",
          "notes": "Distinct from _instrukcja_ (a statement); an expression always evaluates to a value.",
          "anchor": "term-expression"
        },
        {
          "en": "operator",
          "target": "operator",
          "use": "pl",
          "notes": "Direct cognate.",
          "anchor": "term-operator"
        },
        {
          "en": "statement (executable)",
          "target": "instrukcja",
          "use": "pl",
          "notes": "The imperative sense: a line of code that does something and gets executed. Keep distinct from _wyrażenie_ (expression) and from the logical-claim sense below.",
          "anchor": "term-statement"
        },
        {
          "en": "statement (logical claim)",
          "target": "zdanie / zdanie logiczne",
          "use": "pl",
          "notes": "The proposition sense: a claim that is true or false. Pick by meaning, not by the English word; never conflate with _instrukcja_.",
          "anchor": "term-statement-2"
        },
        {
          "en": "function",
          "target": "funkcja",
          "use": "pl",
          "notes": "The keyword `function` in code stays English; the concept in prose is _funkcja_.",
          "anchor": "term-function"
        },
        {
          "en": "to call (a function)",
          "target": "wywoływać / wywołać",
          "use": "pl",
          "anchor": "term-to-call"
        },
        {
          "en": "to define (a function)",
          "target": "definiować / zdefiniować",
          "use": "pl",
          "anchor": "term-to-define"
        },
        {
          "en": "parameter",
          "target": "parametr",
          "use": "pl",
          "notes": "The declaration-site name. Keep distinct from _argument_ even though Polish developers sometimes conflate the two informally; Jiki's own writing keeps the textbook-correct distinction.",
          "anchor": "term-parameter"
        },
        {
          "en": "argument",
          "target": "argument",
          "use": "pl",
          "notes": "The call-site value. See note on _parametr_ above.",
          "anchor": "term-argument"
        },
        {
          "en": "input (to a function)",
          "target": "dane wejściowe",
          "use": "pl",
          "anchor": "term-input"
        },
        {
          "en": "output",
          "target": "dane wyjściowe",
          "use": "pl",
          "notes": "Where the specific value returned is meant, use _wynik_ or _wartość zwracana_ (see below) instead.",
          "anchor": "term-output"
        },
        {
          "en": "to return (a value)",
          "target": "zwracać / zwrócić",
          "use": "pl",
          "notes": "The verb; keep distinct from the noun below.",
          "anchor": "term-to-return"
        },
        {
          "en": "return value",
          "target": "wartość zwracana",
          "use": "pl",
          "notes": "The noun; fixed standard phrase.",
          "anchor": "term-return-value"
        },
        {
          "en": "pure function",
          "target": "funkcja czysta",
          "use": "pl",
          "anchor": "term-pure-function"
        }
      ]
    },
    {
      "title": "Loops, state & program flow",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "keyword",
          "target": "słowo kluczowe",
          "use": "pl",
          "anchor": "term-keyword"
        },
        {
          "en": "variable",
          "target": "zmienna",
          "use": "pl",
          "anchor": "term-variable"
        },
        {
          "en": "assignment",
          "target": "przypisanie",
          "use": "pl",
          "notes": "The noun; keep distinct from the verb below.",
          "anchor": "term-assignment"
        },
        {
          "en": "to assign",
          "target": "przypisać / przypisywać",
          "use": "pl",
          "notes": "The verb.",
          "anchor": "term-to-assign"
        },
        {
          "en": "code block",
          "target": "blok kodu",
          "use": "pl",
          "notes": "Keep distinct from _zakres_ (scope) below; they are related but not the same thing.",
          "anchor": "term-code-block"
        },
        {
          "en": "scope",
          "target": "zakres",
          "use": "pl",
          "notes": "Keep distinct from _blok kodu_ (code block); a block establishes a scope, it is not the same as one.",
          "anchor": "term-scope"
        },
        {
          "en": "error",
          "target": "błąd",
          "use": "pl",
          "notes": "General error. Keep distinct from _wyjątek_ (exception) below.",
          "anchor": "term-error"
        },
        {
          "en": "exception",
          "target": "wyjątek",
          "use": "pl",
          "notes": "The specific catchable-error-object sense, distinct from _błąd_ (a general error).",
          "anchor": "term-exception"
        },
        {
          "en": "nested",
          "target": "zagnieżdżony / zagnieżdżona / zagnieżdżone",
          "use": "pl",
          "notes": "Agrees in gender/number with the noun it modifies, e.g. _zagnieżdżona pętla_ = nested loop.",
          "anchor": "term-nested"
        },
        {
          "en": "iteration",
          "target": "iteracja",
          "use": "pl",
          "anchor": "term-iteration"
        },
        {
          "en": "to run / execute (code)",
          "target": "uruchomić / uruchamiać",
          "use": "pl",
          "notes": "Use for launching a program.",
          "anchor": "term-to-run-execute"
        },
        {
          "en": "element",
          "target": "zob. \"Values & data types\"",
          "use": "pl",
          "anchor": "term-element-2"
        },
        {
          "en": "loop",
          "target": "pętla",
          "use": "pl",
          "anchor": "term-loop"
        },
        {
          "en": "for loop",
          "target": "pętla for",
          "use": "pl",
          "notes": "Keep `for` in backticks (real keyword) + _pętla_.",
          "anchor": "term-for-loop"
        },
        {
          "en": "while loop",
          "target": "pętla while",
          "use": "pl",
          "notes": "As above.",
          "anchor": "term-while-loop"
        },
        {
          "en": "for-of loop",
          "target": "pętla for...of",
          "use": "pl",
          "notes": "As above; no independent Polish name exists for this construct.",
          "anchor": "term-for-of-loop"
        },
        {
          "en": "loop body",
          "target": "ciało pętli",
          "use": "pl",
          "anchor": "term-loop-body"
        }
      ]
    },
    {
      "title": "Tooling & engineering",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
