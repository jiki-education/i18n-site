      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "if statement",
          "target": "câu lệnh if",
          "use": "vi",
          "notes": "Keep `if` in code font.",
          "anchor": "term-if-statement"
        },
        {
          "en": "condition",
          "target": "điều kiện",
          "use": "vi",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-condition"
        },
        {
          "en": "comparison",
          "target": "phép so sánh",
          "use": "vi",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-comparison"
        },
        {
          "en": "expression",
          "target": "biểu thức",
          "use": "vi",
          "anchor": "term-expression"
        },
        {
          "en": "operator",
          "target": "toán tử",
          "use": "vi",
          "anchor": "term-operator"
        },
        {
          "en": "NOT operator / logical negation",
          "target": "phép phủ định",
          "use": "vi",
          "notes": "The keyword `not`/`!` in code stays English.",
          "anchor": "term-not-operator-logical-negation"
        },
        {
          "en": "statement (executable)",
          "target": "câu lệnh",
          "use": "vi",
          "notes": "The imperative sense: a line of code that does something and gets executed.",
          "anchor": "term-statement"
        },
        {
          "en": "statement (logical claim)",
          "target": "mệnh đề",
          "use": "vi",
          "notes": "The proposition sense: a claim that is true or false. Pick by meaning, not by the English word.",
          "anchor": "term-statement-2"
        },
        {
          "en": "function",
          "target": "hàm",
          "use": "vi",
          "notes": "The *keyword* `function` in code stays English; the concept in prose is \"hàm\".",
          "anchor": "term-function"
        },
        {
          "en": "to call (a function)",
          "target": "gọi hàm",
          "use": "vi",
          "anchor": "term-to-call"
        },
        {
          "en": "to define (a function)",
          "target": "định nghĩa hàm",
          "use": "vi",
          "anchor": "term-to-define"
        },
        {
          "en": "parameter",
          "target": "tham số",
          "use": "vi",
          "notes": "The declaration-site name.",
          "anchor": "term-parameter"
        },
        {
          "en": "argument",
          "target": "đối số",
          "use": "vi",
          "notes": "The call-site value. Keep distinct from tham số.",
          "anchor": "term-argument"
        },
        {
          "en": "input (to a function)",
          "target": "đầu vào",
          "use": "vi",
          "notes": "The concept, not the `input()` I/O function, which stays as code.",
          "anchor": "term-input"
        },
        {
          "en": "output",
          "target": "đầu ra",
          "use": "vi",
          "anchor": "term-output"
        },
        {
          "en": "to return (a value)",
          "target": "trả về",
          "use": "vi",
          "notes": "\"Hàm trả về một giá trị.\" The keyword `return` in code stays English.",
          "anchor": "term-to-return"
        },
        {
          "en": "return value",
          "target": "giá trị trả về",
          "use": "vi",
          "notes": "Keep distinct from the verb above.",
          "anchor": "term-return-value"
        },
        {
          "en": "pure function",
          "target": "hàm thuần túy",
          "use": "vi",
          "notes": "**Low confidence, flagged for native-speaker review**: \"hàm thuần khiết\" is a competing calque and English \"pure function\" is also common in practice; source base for this term is thinner than others.",
          "anchor": "term-pure-function"
        }
      ]
    },
