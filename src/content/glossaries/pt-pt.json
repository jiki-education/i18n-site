        {
          "en": "programming / coding",
          "target": "programação",
          "use": "pt-pt",
          "notes": "Use `programação` consistently.",
          "anchor": "term-programming-coding"
        },
        {
          "en": "tech / tech industry",
          "target": "setor tecnológico",
          "use": "pt-pt",
          "notes": "More restrained register than pt-BR's \"mercado de tech\"; loanword \"tech\" alone reads too casual for European Portuguese written prose.",
          "anchor": "term-tech-tech-industry"
        },
        {
          "en": "developer",
          "target": "programador(a)",
          "use": "pt-pt",
          "notes": "\"Desenvolvedor\" is a Brazilian-leaning form; \"programador(a)\" is the natural European Portuguese equivalent.",
          "anchor": "term-developer"
        }
      ]
    },
    {
      "title": "Values & data types",
