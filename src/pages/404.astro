---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout title="Not found">
  <PageHeader
    title="Nothing here"
    subtitle="This site is rebuilt every time a translation lands, so a link can go stale. Try the language list."
  />
  <div class="lg-container py-10">
    <a
      href="/"
      class="inline-block rounded-lg bg-purple-600 px-5 py-2.5 text-[15px] font-semibold text-white transition hover:bg-purple-700"
    >
      All languages
    </a>
  </div>
</Layout>
