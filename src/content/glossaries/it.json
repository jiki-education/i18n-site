    {
      "title": "Platform & curriculum vocabulary",
      "level": 3,
      "scope": "locale",
      "intro": "",
      "columns": {
        "en": 0,
        "target": 1,
        "use": 2,
        "notes": 3
      },
      "terms": [
        {
          "en": "feature (platform capability)",
          "target": "funzionalità",
          "use": "it",
          "notes": "Deliberately distinct from _funzione_ (function) to avoid collision.",
          "anchor": "term-feature"
        },
        {
          "en": "lesson",
          "target": "lezione",
          "use": "it",
          "anchor": "term-lesson"
        },
        {
          "en": "exercise",
          "target": "esercizio",
          "use": "it",
          "anchor": "term-exercise"
        },
        {
          "en": "scenario",
          "target": "scenario",
          "use": "it",
          "notes": "Jiki-specific structured variant within an exercise.",
          "anchor": "term-scenario"
        },
        {
          "en": "curriculum",
          "target": "percorso",
          "use": "it",
          "notes": "Never bare \"curriculum\": in Italian it means a CV/résumé, a false friend. Use _percorso_ for the learning-curriculum sense.",
          "anchor": "term-curriculum"
        },
        {
          "en": "level",
          "target": "livello",
          "use": "it",
          "notes": "The curriculum's structural unit.",
          "anchor": "term-level"
        },
        {
          "en": "pathway",
          "target": "percorso",
          "use": "it",
          "notes": "A structured learning sequence. Same word as _curriculum_ above; the two senses rarely appear together in one document.",
          "anchor": "term-pathway"
        },
        {
          "en": "track (curriculum path)",
          "target": "indirizzo",
          "use": "it",
          "notes": "Low-confidence pick: no established Italian pair mirrors the pathway/track distinction. \"Indirizzo\" is a real Italian school term for a curricular specialization, chosen to stay distinct from _percorso_ (pathway). Flag for native-speaker confirmation.",
          "anchor": "term-track"
        },
        {
          "en": "syllabus",
          "target": "programma del corso",
          "use": "it",
          "anchor": "term-syllabus"
        },
        {
          "en": "mentor / mentoring",
          "target": "mentore / mentoring",
          "use": "it",
          "notes": "\"Mentoring\" is used as-is; \"mentore\" is the native word for the person.",
          "anchor": "term-mentor-mentoring"
        },
        {
          "en": "tutorial",
          "target": "tutorial",
          "use": "en",
          "notes": "Established as-is in Italian tech/education writing.",
          "anchor": "term-tutorial"
        },
        {
          "en": "solution (learner's submission)",
          "target": "soluzione",
          "use": "it",
          "anchor": "term-solution"
        }
