      },
      "terms": [
        {
          "en": "if statement / conditional",
          "target": "condicional",
          "use": "es",
          "notes": "Plural: _condicionales_. The full form _la sentencia condicional_ is available when it reads better.",
          "anchor": "term-if-statement-conditional"
        },
        {
          "en": "condition",
          "target": "condición",
          "use": "es",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-condition"
        },
        {
          "en": "comparison",
          "target": "comparación",
          "use": "es",
          "notes": "Ordinary word; stands alone.",
          "anchor": "term-comparison"
        },
        {
          "en": "expression",
          "target": "expresión",
          "use": "es",
          "anchor": "term-expression"
        },
        {
          "en": "operator",
          "target": "operador",
          "use": "es",
          "anchor": "term-operator"
        },
        {
          "en": "NOT operator / logical negation",
          "target": "negación (lógica)",
          "use": "es",
          "anchor": "term-not-operator-logical-negation"
        },
        {
          "en": "function",
          "target": "función",
          "use": "es",
          "notes": "The *keyword* `function` in code stays English; the concept in prose is _función_.",
          "anchor": "term-function"
        },
        {
          "en": "to call (a function)",
          "target": "llamar (a una función)",
          "use": "es",
          "notes": "Keep the personal _a_: _llamar a una función_. _invocar_ is an acceptable synonym in a fuller explanation.",
          "anchor": "term-to-call"
        },
        {
          "en": "to define (a function)",
          "target": "definir (una función)",
          "use": "es",
          "anchor": "term-to-define"
        },
        {
          "en": "parameter",
          "target": "parámetro",
          "use": "es",
          "notes": "Declaration-site name.",
          "anchor": "term-parameter"
        },
        {
          "en": "argument",
          "target": "argumento",
          "use": "es",
          "notes": "Call-site value.",
          "anchor": "term-argument"
        },
        {
          "en": "input (to a function)",
          "target": "entrada",
          "use": "es",
          "anchor": "term-input"
        },
        {
          "en": "output",
          "target": "salida",
          "use": "es",
          "anchor": "term-output"
        },
        {
          "en": "to return (a value)",
          "target": "devolver",
          "use": "es",
          "notes": "Preferred over _retornar_. \"La función devuelve un valor.\"",
          "anchor": "term-to-return"
        },
        {
          "en": "pure function",
          "target": "función pura",
          "use": "es",
          "anchor": "term-pure-function"
        }
      ]
    },
    {
      "title": "Loops, state & program flow",
